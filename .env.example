# Only mock mode is implemented. Live mode fails explicitly.
APP_MODE=mock
BACKEND_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:4b
# The only allowed model. Current qwen3:4b has no advertised embedding capability;
# live vector retrieval must fail explicitly. Start with lexical retrieval.
EMBEDDING_MODEL=qwen3:4b
# Future Qdrant local storage directory; only the backend should open it.
QDRANT_PATH=./var/qdrant
