# Only mock mode is implemented. Live mode fails explicitly.
APP_MODE=mock
BACKEND_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Embedding-only Ollama process: python -m evidencedesk.retrieval.embedding_server
# D must wire this separate client URL; both processes use the same Qwen weights.
EMBEDDING_OLLAMA_BASE_URL=http://127.0.0.1:11435
GENERATION_MODEL=qwen3:4b
# Raw last-token Qwen vectors need the embedding-only process above.
EMBEDDING_MODEL=qwen3:4b
# Future Qdrant local storage directory; only the backend should open it.
QDRANT_PATH=./var/qdrant
