# Only mock mode is implemented. Live mode fails explicitly.
APP_MODE=mock
BACKEND_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text:v1.5
# Native output is 768; the C1 index uses the trained 512-dimensional MRL profile.
EMBEDDING_DIMENSIONS=512
# Persistent Qdrant local storage directory; only the backend should open it.
QDRANT_PATH=./var/qdrant
